# --- Database -------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Sign-in --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# From Google Cloud Console > APIs & Services > Credentials (see README).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed when hosting anywhere other than Vercel.
AUTH_TRUST_HOST="true"

# Only Google accounts on these domains may sign in (comma separated).
# Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS=""
# These accounts get the teacher dashboard (comma separated).
TEACHER_EMAILS=""

# Local development only: a no-password sign-in form so you can try the site
# before Google is set up. It is ignored in production builds.
ALLOW_DEV_LOGIN="true"

# --- Branding -------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Breakpoint"

# --- Build folder --------------------------------------------------------
# Set this if the project lives in a cloud-synced folder (iCloud Desktop,
# OneDrive). Folders ending in .nosync are skipped by iCloud.
# NEXT_DIST_DIR=".next.nosync"
