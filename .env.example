# --- Database -------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Sign-in --------------------------------------------------------------
# Signs the session cookies. Generate with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed when hosting anywhere other than Vercel.
AUTH_TRUST_HOST="true"

# The teacher's sign-in. There is one teacher account, and this is it: to
# change the username or password, change them here and restart the site.
# On the live site the password needs at least 8 characters, or teacher
# sign-in is switched off; make it long and keep it private. On your own
# computer (npm run dev) any password works, for trying things out.
TEACHER_USERNAME="teacher"
TEACHER_PASSWORD=""
# Shown in the corner of the site. Optional.
TEACHER_NAME=""
# How long a teacher sign-in lasts before asking again, in hours. Optional;
# 12 unless set. Changing the username or password above also signs the
# teacher out everywhere, and Teacher > Settings has "Sign out everywhere".
# TEACHER_SESSION_HOURS="12"

# --- Branding -------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Breakpoint"

# --- Build folder --------------------------------------------------------
# Set this if the project lives in a cloud-synced folder (iCloud Desktop,
# OneDrive). Folders ending in .nosync are skipped by iCloud.
# NEXT_DIST_DIR=".next.nosync"

# --- Trying it on a phone (development only) ------------------------------
# Hostnames of other devices allowed to load the dev server, comma separated.
# With this set, open http://YOUR-COMPUTER-ADDRESS:3000 on a phone that is on
# the same Wi-Fi. Leave it out on the live site.
# DEV_ALLOWED_ORIGINS="192.168.*.*,10.*.*.*,*.local"
