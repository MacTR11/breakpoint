generator client {
  provider = "prisma-client-js"
}

// SQLite keeps local setup to zero. For production, change provider to
// "postgresql" and point DATABASE_URL at a hosted database (see README).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Students are created by the teacher (one at a time or from a CSV). The
// teacher's own sign-in is set in .env, so their row never holds a password.
model User {
  id           String   @id @default(cuid())
  username     String   @unique // lower case; what is typed to sign in
  name         String
  passwordHash String   @default("") // scrypt, see src/lib/passwords.ts; empty means no password works
  role         String   @default("STUDENT") // STUDENT | TEACHER
  sessionEpoch Int      @default(0) // raised when the password changes, which signs the old password's sessions out
  classId      String? // the teaching group, for students
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime?

  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions Submission[]
  solves      Solve[]
  hintUnlocks HintUnlock[]
  dailyBonus  DailyBonus[]
  mockPapers  MockPaper[]

  @@index([classId])
}

// A teaching group, such as 12A. Classes are compared on their averages.
model Class {
  id        String   @id @default(cuid())
  name      String   @unique
  year      String   @default("LOWER") // LOWER sixth | UPPER sixth
  createdAt DateTime @default(now())

  students User[]
  homework Homework[]
}

// Site-wide choices the teacher makes in the dashboard, by name.
model Setting {
  key   String @id
  value String
}

// Wrong sign-in attempts per username, so passwords cannot be guessed at speed.
model LoginThrottle {
  username    String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Problem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  kind        String // CODE | PUZZLE
  difficulty  String // EASY | MEDIUM | HARD
  topic       String
  points      Int
  description String // Markdown
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
  fromFile    Boolean @default(false) // loaded from content/problems, so the seed may update or remove it
  track       String  @default("") // topic strand, see src/lib/tracks.ts
  specRef     String  @default("") // OCR H446 reference, e.g. "2.3.1"; see src/lib/spec.ts
  hints       String? // JSON: string[] of Markdown hints, revealed one at a time

  // CODE problems
  style        String  @default("WRITE") // WRITE from scratch, or FIX the broken starter code
  functionName String?
  starterCode  String?
  tests        String? // JSON: [{ args: [...] | steps: [...], expected: ..., hidden?: boolean }]
  solution     String? // reference solution, only ever shown to teachers
  banned       String? // JSON: string[] of text the code may not contain, e.g. ["sorted("]

  // PUZZLE problems
  options     String? // JSON: string[]; empty array means a typed answer
  answer      String? // index into options, or the typed answer
  explanation String? // Markdown, shown once answered correctly

  createdAt DateTime @default(now())

  submissions Submission[]
  solves      Solve[]
  contests    ContestProblem[]
  hintUnlocks HintUnlock[]
  homework    HomeworkProblem[]
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String // the code, or the answer given to a puzzle
  status    String // ACCEPTED | WRONG | ERROR | TIMEOUT
  passed    Int
  total     Int
  penalty   Int      @default(0) // points lost for a wrong puzzle answer
  // How the code was written, as reported by the student's browser. A guide
  // for a conversation, never proof: see src/lib/integrity.ts.
  pastedChars  Int @default(0) // characters pasted or dropped in from outside the editor
  largestPaste Int @default(0) // the biggest single paste
  typedChars   Int @default(0) // characters typed
  seconds      Int @default(0) // time the editor was open before submitting
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
}

// One row per student per solved problem: what leaderboards are built from.
model Solve {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  points    Int
  attempts  Int
  solvedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId, solvedAt])
}

// A hint a student has spent one of their hint tokens on.
model HintUnlock {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  index     Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId, index])
}

// A bonus hint token, earned by solving the daily challenge on its day.
model DailyBonus {
  id        String   @id @default(cuid())
  userId    String
  day       String // "2026-10-02", in UK time
  problemId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// A contest with no dates is a ready-made pack waiting to be scheduled.
model Contest {
  id          String    @id @default(cuid())
  slug        String?   @unique // set for packs loaded from content/contests.json
  title       String
  description String    @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt // when it was last scheduled or changed, for the bell

  problems ContestProblem[]
}

model ContestProblem {
  contestId String
  problemId String
  sortOrder Int    @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([contestId, problemId])
}

// Challenges the teacher sets for a class, or for everyone, by a date. A
// challenge counts as done whenever it was solved, even before it was set.
model Homework {
  id        String   @id @default(cuid())
  title     String
  note      String   @default("")
  classId   String? // null: every student
  dueAt     DateTime
  createdAt DateTime @default(now())

  class    Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  problems HomeworkProblem[]

  @@index([dueAt])
}

model HomeworkProblem {
  homeworkId String
  problemId  String
  sortOrder  Int    @default(0)

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  problem  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([homeworkId, problemId])
}

// A timed paper of exam-style questions a student sat. Marks are worked out
// from the submissions made between startedAt and the end; see src/lib/mock.ts.
model MockPaper {
  id         String    @id @default(cuid())
  userId     String
  problemIds String // JSON: string[], in paper order
  minutes    Int
  startedAt  DateTime  @default(now())
  endsAt     DateTime
  finishedAt DateTime? // set when the student hands it in early

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
