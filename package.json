{
  "name": "breakpoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-pyodide.mjs && prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "tsx scripts/verify-problems.ts",
    "check": "tsx scripts/logic-check.ts",
    "e2e": "playwright test",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "release": "prisma db push --skip-generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.13",
    "@prisma/client": "^6.19.3",
    "@uiw/react-codemirror": "^4.25.12",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "pyodide": "^314.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
